{
    "name": "open-web-analytics/owa-php-sdk",
    "description": "PHP SDK for Open Web Analytics: server-side event tracking and the REST API.",
    "keywords": ["open-web-analytics","owa","web-analytics","analytics"],
    "homepage": "https://www.openwebanalytics.com",
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "The OWA Team",
            "email": "hello@openwebanalytics.com"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": ">=8.2",
        "ext-iconv": "*",
        "ext-json": "*"
    },
    "suggest": {
        "ext-curl": "Used for HTTP requests when available; PHP streams are used otherwise."
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OwaSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OwaSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit"
    }
}
